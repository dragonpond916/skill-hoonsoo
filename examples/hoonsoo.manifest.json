{
  "$schema": "../schemas/hoonsoo.manifest.schema.json",
  "schemaVersion": "0.3.0",
  "kind": "HoonsooSkill",
  "metadata": {
    "name": "hoonsoo",
    "displayName": "Hoonsoo",
    "version": "0.3.0-alpha.1",
    "description": "Review both document content and grammar after stable saved states without modifying the source file.",
    "keywords": [
      "advice-only",
      "save-triggered-review",
      "versioned-artifacts",
      "document-review"
    ]
  },
  "skill": {
    "standard": "agentskills.io",
    "path": "./skills/hoonsoo/SKILL.md",
    "implicitInvocation": true
  },
  "command": {
    "codexInvocation": "$hoonsoo <filePath> <prompt>",
    "claudeInvocation": "/skill-hoonsoo:hoonsoo <filePath> <prompt>",
    "action": "start-or-reconfigure-monitor",
    "reviewScope": "content-and-grammar",
    "arguments": [
      {
        "name": "filePath",
        "position": 0,
        "type": "path",
        "required": true,
        "capture": "token",
        "description": "Absolute local file path. Quote a path that contains spaces."
      },
      {
        "name": "prompt",
        "position": 1,
        "type": "string",
        "required": false,
        "capture": "remainder",
        "default": "",
        "description": "Optional priorities or constraints applied to the combined content and grammar review."
      }
    ]
  },
  "runtime": {
    "kind": "stdio-mcp-process",
    "protocol": "jsonl-stdio",
    "state": {
      "scope": "monitor-session",
      "storage": "memory",
      "retention": "until-monitor-stop-or-process-exit",
      "persistDocumentContent": false,
      "versionedCollections": [
        "revisionSnapshots",
        "diffArtifacts",
        "fieldArtifacts",
        "feedbackArtifacts"
      ]
    }
  },
  "lifecycle": {
    "scope": "active-agent-turn",
    "startOnInvocation": true,
    "stopConditions": [
      "user-cancelled",
      "session-ended",
      "target-deleted",
      "runtime-failed",
      "idle-timeout"
    ],
    "onTargetDeleted": "confirm-twice-then-notify-and-stop",
    "onTargetReplaced": "capture-new-inode-as-saved-revision",
    "monitorUniqueness": "one-active-monitor-per-process-and-target"
  },
  "watch": {
    "mode": "metadata-polling",
    "pollIntervalMs": 2000,
    "throttling": {
      "enabled": false
    },
    "saveDetection": {
      "boundary": "stable-disk-snapshot",
      "candidateMetadata": [
        "device",
        "inode",
        "size",
        "mtimeNs",
        "ctimeNs"
      ],
      "contentIdentity": "raw-utf8-sha256",
      "sameContentSave": "activity-only-no-revision",
      "whitespaceOnlySave": "content-revision",
      "manualVsAutosave": "not-distinguishable",
      "consistencyRead": "stat-read-stat-with-bounded-retry",
      "missingConfirmationProbes": 2
    },
    "idleWarningMs": 60000,
    "idleStopMs": 90000,
    "maxFileBytes": 5242880
  },
  "agents": {
    "monitoringAgent": {
      "role": "save-monitor",
      "implementation": "deterministic-worker",
      "modelClass": "none",
      "responsibility": "Detect metadata changes, confirm a stable disk snapshot, and distinguish save activity from content revisions.",
      "inputs": [
        "target-path",
        "save-detection-policy"
      ],
      "outputs": [
        "save-sequence",
        "stable-snapshot-reference"
      ],
      "effectPolicy": "read-target-and-update-session-memory-only"
    },
    "diffCheckAgent": {
      "role": "revision-diff-checker",
      "implementation": "deterministic-worker",
      "modelClass": "none",
      "responsibility": "Version every changed stable snapshot and store bounded changed excerpts and line ranges as session artifacts.",
      "inputs": [
        "previous-revision-snapshot",
        "current-stable-snapshot"
      ],
      "outputs": [
        "revision-artifact",
        "diff-artifact"
      ],
      "effectPolicy": "compute-and-update-session-memory-only"
    },
    "fieldCheckAgent": {
      "role": "field-checker",
      "implementation": "llm-agent",
      "modelClass": "efficient",
      "responsibility": "Read the referenced revision or diff artifact, identify the document domain, type, language, intent, and useful content and grammar review focus, then store a versioned field artifact.",
      "inputs": [
        "monitor-reference",
        "revision-artifact-reference",
        "diff-artifact-reference",
        "prompt-reference"
      ],
      "outputs": [
        "field-artifact-reference"
      ],
      "effectPolicy": "read-target-artifacts-and-update-session-memory-only"
    },
    "mainReviewAgent": {
      "role": "combined-reviewer",
      "implementation": "llm-agent",
      "modelClass": "flagship",
      "responsibility": "Read the field artifact, current revision changes, invocation prompt, and relevant published feedback, then store one combined content and grammar feedback draft.",
      "inputs": [
        "field-artifact-reference",
        "review-bundle-reference"
      ],
      "outputs": [
        "feedback-artifact-reference"
      ],
      "effectPolicy": "read-target-artifacts-and-update-session-memory-only"
    },
    "revisionGate": {
      "role": "revision-gate",
      "implementation": "deterministic-worker",
      "modelClass": "none",
      "responsibility": "Reject field or feedback writes whose revision, content hash, or source artifact no longer matches the current monitor state.",
      "inputs": [
        "artifact-reference",
        "runtime-status"
      ],
      "outputs": [
        "accepted-artifact",
        "stale-decision"
      ],
      "effectPolicy": "validate-session-memory-only"
    },
    "idleGuard": {
      "role": "idle-guard",
      "implementation": "deterministic-worker",
      "modelClass": "none",
      "responsibility": "Reset on a content-changing saved revision, warn once after 60 seconds without content change, and stop after 90 seconds.",
      "inputs": [
        "last-content-revision",
        "idle-policy"
      ],
      "outputs": [
        "idle-warning",
        "idle-stop"
      ],
      "effectPolicy": "timer-and-session-state-only"
    },
    "sessionOrchestrator": {
      "role": "host-session-orchestrator",
      "implementation": "host-agent",
      "modelClass": "current-host",
      "responsibility": "Pass artifact references between stages, validate the latest revision, publish stored natural-language feedback, mark it published, and resume a no-timeout wait.",
      "inputs": [
        "artifact-references",
        "runtime-status"
      ],
      "outputs": [
        "numbered-advice-batch"
      ],
      "effectPolicy": "presentation-and-session-control-only"
    }
  },
  "pipeline": {
    "sequence": [
      "monitoringAgent",
      "diffCheckAgent",
      "fieldCheckAgent",
      "mainReviewAgent",
      "revisionGate",
      "sessionOrchestrator"
    ],
    "baseline": {
      "revision": 0,
      "fieldInput": "full-revision-artifact",
      "review": "combined-content-and-grammar"
    },
    "savedRevision": {
      "fieldInput": "diff-artifact",
      "reviewInput": "review-bundle",
      "review": "combined-content-and-grammar"
    },
    "backlogPolicy": "latest-revision-wins-with-aggregate-diff-from-last-published",
    "staleResultPolicy": "reject-by-revision-content-hash-and-artifact-id",
    "interAgentPayload": "artifact-references-only",
    "normalWait": "event-driven-without-timeout"
  },
  "mcpTools": {
    "monitoring": [
      "start_monitor",
      "wait_for_save",
      "get_status",
      "stop_monitor"
    ],
    "artifactReads": [
      "read_revision",
      "read_diff_artifact",
      "read_field_analysis",
      "read_review_bundle",
      "read_feedback_artifact"
    ],
    "sessionWrites": [
      "store_field_analysis",
      "store_feedback_draft",
      "mark_feedback_published"
    ]
  },
  "review": {
    "scope": "content-and-grammar",
    "promptPolicy": "merge-as-additional-priorities",
    "contentChecks": [
      "completeness",
      "consistency",
      "clarity",
      "risk",
      "missing-assumptions",
      "actionability"
    ],
    "grammarChecks": [
      "file-syntax",
      "natural-language-grammar",
      "spelling",
      "punctuation",
      "style",
      "terminology-consistency",
      "whitespace-and-formatting"
    ]
  },
  "output": {
    "mode": "advice-only",
    "presentation": "numbered-natural-language",
    "visibleLabels": [
      "revision"
    ],
    "forbiddenLabels": [
      "anchor",
      "category",
      "severity",
      "message",
      "rationale",
      "suggestedAction",
      "confidence"
    ],
    "targetMutation": "forbidden"
  },
  "permissions": {
    "filesystem": {
      "readTarget": true,
      "observeTarget": true,
      "writeTarget": false,
      "writeWorkspace": false
    },
    "runtimeMemory": {
      "writeVersionedArtifacts": true,
      "persistAfterStop": false
    },
    "network": {
      "mode": "none"
    },
    "dataHandling": {
      "documentInterAgentPassing": "references-only",
      "artifactReads": "direct-mcp-access",
      "snapshotsRemainLocal": true,
      "retention": "monitor-session"
    }
  },
  "extensions": {
    "hoonsoo.model-routing": {
      "mode": "host-capability-gated",
      "deterministicRoles": [
        "monitoringAgent",
        "diffCheckAgent",
        "revisionGate",
        "idleGuard"
      ],
      "hostProfiles": {
        "codex": {
          "fieldChecker": "gpt-5.6-luna",
          "fieldCheckerReasoning": "low",
          "mainReviewer": "gpt-5.6-sol",
          "mainReviewerReasoning": "high",
          "fallback": "current-host-model"
        },
        "claude-code": {
          "fieldChecker": "haiku",
          "fieldCheckerReasoning": "low",
          "mainReviewer": "fable",
          "mainReviewerReasoning": "high",
          "fallback": "current-host-model"
        }
      }
    },
    "hoonsoo.optional-source-scout": {
      "enabled": "on-demand-only",
      "automaticInstallation": false
    }
  }
}
