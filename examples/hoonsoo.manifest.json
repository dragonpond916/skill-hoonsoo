{
  "$schema": "../schemas/hoonsoo.manifest.schema.json",
  "schemaVersion": "0.1.0",
  "kind": "HoonsooSkill",
  "metadata": {
    "name": "hoonsoo",
    "displayName": "Hoonsoo",
    "version": "0.1.0-alpha.1",
    "description": "Monitor a document during the active LLM session and provide contextual or grammar-focused advice without modifying the source file.",
    "keywords": [
      "advice-only",
      "delta-review",
      "document-review",
      "human-in-the-loop"
    ]
  },
  "skill": {
    "standard": "agentskills.io",
    "path": "./skills/hoonsoo/SKILL.md",
    "frontmatterPolicy": "portable-core-only",
    "implicitInvocation": true
  },
  "runtime": {
    "kind": "supervisor-process",
    "entrypoint": {
      "command": "hoonsoo-runtime",
      "args": [
        "serve"
      ]
    },
    "protocol": "jsonl-stdio",
    "state": {
      "scope": "session",
      "storage": "memory",
      "retention": "until-session-end",
      "persistDocumentContent": false
    }
  },
  "commands": {
    "context": {
      "invocation": "/hoonsoo:context",
      "summary": "Monitor a document and provide domain-aware contextual advice.",
      "reviewProfile": "context",
      "action": "start-or-reconfigure-monitor",
      "arguments": [
        {
          "name": "filePath",
          "position": 0,
          "type": "path",
          "required": true,
          "capture": "token",
          "description": "Path of the document to monitor. Quote paths containing spaces."
        },
        {
          "name": "prompt",
          "position": 1,
          "type": "string",
          "required": false,
          "capture": "remainder",
          "default": "",
          "description": "Additional constraints to apply to contextual analysis."
        }
      ]
    },
    "grammar": {
      "invocation": "/hoonsoo:grammar",
      "summary": "Monitor a document and review only syntax, grammar, spelling, and style.",
      "reviewProfile": "grammar",
      "action": "start-or-reconfigure-monitor",
      "arguments": [
        {
          "name": "filePath",
          "position": 0,
          "type": "path",
          "required": true,
          "capture": "token",
          "description": "Path of the document to monitor. Quote paths containing spaces."
        },
        {
          "name": "prompt",
          "position": 1,
          "type": "string",
          "required": false,
          "capture": "remainder",
          "default": "",
          "description": "Additional constraints that remain limited to grammar and syntax review."
        }
      ]
    }
  },
  "lifecycle": {
    "scope": "active-session",
    "startOnCommand": true,
    "stopConditions": [
      "user-cancelled",
      "session-ended",
      "target-deleted",
      "runtime-failed"
    ],
    "onTargetDeleted": "notify-and-stop",
    "onTargetReplaced": "rebaseline-and-review",
    "monitorUniqueness": "one-per-session-and-target"
  },
  "watch": {
    "mode": "polling",
    "pollIntervalMs": 2000,
    "settleMs": 250,
    "probe": "metadata-first",
    "snapshotRead": "on-change-only",
    "initialSnapshot": "full",
    "snapshotStorage": "memory",
    "maxSnapshots": 2,
    "encoding": "auto-detect",
    "symlinkPolicy": "follow-target",
    "maxFileBytes": 5242880
  },
  "agents": {
    "monitor": {
      "role": "monitor",
      "implementation": "deterministic-worker",
      "responsibility": "Probe the target, emit ordered change revisions, and never send unchanged content to an LLM.",
      "concurrency": {
        "mode": "singleton",
        "maximum": 1,
        "overflow": "coalesce"
      },
      "inputs": [
        "target-path",
        "watch-policy"
      ],
      "outputs": [
        "change-event"
      ],
      "interruptible": false,
      "effectPolicy": "read-compute-and-emit-only"
    },
    "diffChecker": {
      "role": "diff-checker",
      "implementation": "deterministic-worker",
      "responsibility": "Compute per-revision deltas locally and aggregate the net change from the last acknowledged snapshot.",
      "concurrency": {
        "mode": "bounded-pool",
        "maximum": 8,
        "overflow": "coalesce"
      },
      "inputs": [
        "previous-snapshot",
        "current-snapshot",
        "revision"
      ],
      "outputs": [
        "delta",
        "revision-range"
      ],
      "interruptible": true,
      "effectPolicy": "read-compute-and-emit-only"
    },
    "fieldChecker": {
      "role": "field-checker",
      "implementation": "llm-agent",
      "modelClass": "fast",
      "responsibility": "Classify routing metadata before review: professional domains in context mode, and only file format and natural language in grammar mode.",
      "concurrency": {
        "mode": "per-batch",
        "maximum": 2,
        "overflow": "drop-stale"
      },
      "inputs": [
        "aggregated-delta",
        "bounded-context"
      ],
      "outputs": [
        "routing-labels",
        "classification-confidence"
      ],
      "interruptible": true,
      "effectPolicy": "read-compute-and-emit-only"
    },
    "mainReviewer": {
      "role": "main-reviewer",
      "implementation": "host-session-agent",
      "modelClass": "capable",
      "responsibility": "Review only the current aggregate, merge relevant prior advice, and emit advice into the active session.",
      "concurrency": {
        "mode": "singleton",
        "maximum": 1,
        "overflow": "drop-stale"
      },
      "inputs": [
        "aggregated-delta",
        "bounded-context",
        "routing-labels",
        "user-constraints",
        "relevant-prior-advice"
      ],
      "outputs": [
        "advice-batch"
      ],
      "interruptible": true,
      "effectPolicy": "read-compute-and-emit-only"
    }
  },
  "pipeline": {
    "sequence": [
      "monitor",
      "diffChecker",
      "fieldChecker",
      "mainReviewer"
    ],
    "routingPolicy": {
      "context": "professional-domain-classification",
      "grammar": "file-format-and-natural-language-only"
    },
    "delta": {
      "algorithm": "myers-line",
      "localComputation": true,
      "initialModelInput": "full-document-once",
      "subsequentModelInput": "delta-with-bounded-context",
      "contextLines": 5,
      "aggregation": "net-delta-from-last-acknowledged-revision",
      "maxInitialChunkCharacters": 32000,
      "initialOversizedPolicy": "chunk-by-structure",
      "maxDeltaCharacters": 24000,
      "oversizedDeltaPolicy": "chunk-by-structure"
    },
    "batching": {
      "coalesceWindowMs": 250,
      "ordering": "revision-ascending",
      "maxQueuedChanges": 64,
      "overflow": "coalesce-to-latest-net-delta"
    },
    "interruption": {
      "trigger": "new-change-during-main-review",
      "runtimeReviewAction": "abort-active-review",
      "hostGenerationAction": "capability-gated",
      "onUnsupportedHostInterrupt": "mark-stale-and-discard",
      "discardPartialAdvice": true,
      "resumeAfter": "aggregated-delta-ready"
    },
    "cooldownMs": 2000,
    "staleResultPolicy": "discard-by-generation",
    "acknowledgeRevisionAfter": "advice-emitted-or-buffered"
  },
  "reviewProfiles": {
    "context": {
      "semanticAnalysis": true,
      "userPromptPolicy": "merge-as-additional-constraints",
      "domainClassification": {
        "enabled": true,
        "multiLabel": true,
        "taxonomy": [
          "development",
          "legal",
          "product-management",
          "planning",
          "design",
          "data-science",
          "business",
          "general"
        ],
        "fallback": "general"
      },
      "recommendationFocus": [
        "completeness",
        "consistency",
        "clarity",
        "risk",
        "missing-assumptions",
        "actionability"
      ]
    },
    "grammar": {
      "semanticAnalysis": false,
      "userPromptPolicy": "apply-only-to-grammar-and-syntax-scope",
      "validationOrder": [
        "file-syntax",
        "natural-language-grammar",
        "spelling",
        "style"
      ],
      "syntaxValidation": {
        "enabled": true,
        "priority": "first",
        "validators": [
          {
            "id": "markdown",
            "extensions": [
              ".md",
              ".mdx"
            ],
            "checks": [
              "structure",
              "headings",
              "lists",
              "links",
              "fenced-code-blocks"
            ]
          },
          {
            "id": "java",
            "extensions": [
              ".java"
            ],
            "checks": [
              "parse",
              "syntax",
              "compile"
            ],
            "compileWhenProjectContextAvailable": true
          }
        ],
        "toolUnavailablePolicy": "report-limitation-and-continue",
        "sideEffectIsolation": "temporary-workspace-only"
      },
      "naturalLanguageValidation": {
        "enabled": true,
        "languageDetection": "automatic",
        "scope": "human-language-segments",
        "checks": [
          "grammar",
          "spelling",
          "punctuation",
          "style",
          "terminology-consistency"
        ],
        "thoroughness": "exhaustive"
      }
    }
  },
  "output": {
    "mode": "advice-only",
    "delivery": {
      "destination": "active-session",
      "timing": "incremental",
      "format": "markdown",
      "updateStrategy": "append-update-or-invalidate-by-anchor",
      "unsupportedPushFallback": "buffer-until-next-host-turn"
    },
    "mutation": {
      "targetFile": "forbidden",
      "fullDocumentRewrite": "forbidden",
      "patches": "suggestion-only"
    },
    "advice": {
      "requiredFields": [
        "revision",
        "anchor",
        "category",
        "severity",
        "message",
        "rationale",
        "suggestedAction",
        "confidence"
      ],
      "severityOrder": [
        "critical",
        "high",
        "medium",
        "low",
        "note"
      ],
      "includeLocation": true,
      "includeRationale": true,
      "includeSuggestedAction": true,
      "maxItemsPerCycle": 50,
      "overflowPolicy": "continue-in-next-batch"
    }
  },
  "safety": {
    "policy": "advice-only",
    "scope": "all-modes-agents-runtimes-and-adapters",
    "userFileMutation": "forbidden",
    "workspaceMutation": "forbidden",
    "targetOpenMode": "read-only",
    "writeCapabilities": "not-granted",
    "editTools": "excluded",
    "patchApplication": "forbidden",
    "autoFix": "forbidden",
    "exceptions": "none",
    "runtimeTempWrites": "isolated-outside-user-workspace-only",
    "onViolation": "abort-review-and-notify"
  },
  "permissions": {
    "filesystem": {
      "readTarget": true,
      "watchTarget": true,
      "writeTarget": false,
      "writeWorkspace": false,
      "runtimeTempWrite": "isolated-outside-user-workspace-only"
    },
    "process": {
      "spawn": "required",
      "shell": false,
      "sideEffectPolicy": "read-only-user-workspace"
    },
    "network": {
      "mode": "none"
    },
    "session": {
      "emitAdvice": "preferred",
      "interruptHostGeneration": "preferred"
    },
    "dataHandling": {
      "initialFullDocumentToModel": true,
      "subsequentFullDocumentToModel": false,
      "snapshotsRemainLocal": true,
      "retention": "session"
    }
  },
  "hostContract": {
    "packaging": {
      "pluginStandard": "agent-plugins/1.0.0",
      "pluginSchema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
      "skillStandard": "agentskills.io"
    },
    "compatibilityStatement": "portable-packaging-with-capability-gated-runtime-behavior",
    "capabilities": {
      "filesystem.read": {
        "requirement": "required"
      },
      "filesystem.observe": {
        "requirement": "preferred",
        "fallback": "Use local polling at watch.pollIntervalMs."
      },
      "commands.namespaced": {
        "requirement": "preferred",
        "fallback": "Expose equivalent host-native skill aliases while preserving filePath, prompt, and reviewProfile semantics."
      },
      "tools.file-mutation-deny": {
        "requirement": "required"
      },
      "runtime.background-process": {
        "requirement": "required"
      },
      "runtime.review-cancel": {
        "requirement": "required"
      },
      "session.emit": {
        "requirement": "preferred",
        "fallback": "Buffer the newest advice until the next host turn."
      },
      "host.generation-interrupt": {
        "requirement": "optional",
        "fallback": "Cancel Hoonsoo's runtime review, increment the generation, and discard stale output."
      },
      "agents.concurrent": {
        "requirement": "optional",
        "fallback": "Use the runtime worker pool or execute field classification sequentially."
      }
    },
    "adapters": {
      "claude-code": {
        "status": "experimental",
        "descriptor": "./.claude-plugin/plugin.json",
        "capabilities": {
          "filesystem.read": {
            "support": "native"
          },
          "filesystem.observe": {
            "support": "bridge",
            "mechanism": "Plugin monitor or FileChanged hook coordinated by the Hoonsoo supervisor."
          },
          "commands.namespaced": {
            "support": "native",
            "mechanism": "Plugin skills named context and grammar expose /hoonsoo:context and /hoonsoo:grammar."
          },
          "tools.file-mutation-deny": {
            "support": "bridge",
            "mechanism": "Run Hoonsoo roles without Edit, Write, or patch tools; expose no mutation operation from the supervisor."
          },
          "runtime.background-process": {
            "support": "bridge",
            "mechanism": "Plugin monitor or an adapter-managed supervisor process."
          },
          "runtime.review-cancel": {
            "support": "bridge",
            "mechanism": "Abort the Hoonsoo-owned review request and advance its generation."
          },
          "session.emit": {
            "support": "bridge",
            "mechanism": "Experimental plugin monitor notifications.",
            "fallback": "Deliver on the next host turn."
          },
          "host.generation-interrupt": {
            "support": "degraded",
            "mechanism": "Requires an Agent SDK streaming supervisor rather than plugin metadata alone.",
            "fallback": "Discard stale Hoonsoo results."
          },
          "agents.concurrent": {
            "support": "bridge",
            "mechanism": "Claude subagents or the Hoonsoo runtime worker pool."
          }
        }
      },
      "gemini-cli": {
        "status": "planned",
        "descriptor": "./gemini-extension.json",
        "capabilities": {
          "filesystem.read": {
            "support": "native"
          },
          "filesystem.observe": {
            "support": "bridge",
            "mechanism": "Companion runtime exposed through an MCP server."
          },
          "commands.namespaced": {
            "support": "native",
            "mechanism": "commands/hoonsoo/context.toml and grammar.toml expose the logical commands."
          },
          "tools.file-mutation-deny": {
            "support": "bridge",
            "mechanism": "Exclude workspace-writing tools from Hoonsoo roles and expose only read/monitor/advice MCP operations."
          },
          "runtime.background-process": {
            "support": "bridge",
            "mechanism": "A stdio MCP server owns the watcher lifecycle."
          },
          "runtime.review-cancel": {
            "support": "bridge",
            "mechanism": "Abort the Hoonsoo-owned review request and advance its generation."
          },
          "session.emit": {
            "support": "degraded",
            "fallback": "Return the latest aggregate on the next MCP tool call or host turn."
          },
          "host.generation-interrupt": {
            "support": "unsupported",
            "fallback": "Abort only the Hoonsoo runtime request and discard its stale result."
          },
          "agents.concurrent": {
            "support": "bridge",
            "mechanism": "Gemini subagents or the Hoonsoo runtime worker pool."
          }
        }
      },
      "codex": {
        "status": "planned",
        "descriptor": "./.codex-plugin/plugin.json",
        "capabilities": {
          "filesystem.read": {
            "support": "native"
          },
          "filesystem.observe": {
            "support": "bridge",
            "mechanism": "Companion supervisor with polling or host lifecycle hooks."
          },
          "commands.namespaced": {
            "support": "degraded",
            "mechanism": "Generate host-native skill aliases from the two logical command definitions.",
            "fallback": "Use explicit skill invocation when exact namespaced slash commands are unavailable."
          },
          "tools.file-mutation-deny": {
            "support": "bridge",
            "mechanism": "Exclude file-editing and patch tools from Hoonsoo roles; the runtime exposes no mutation operation."
          },
          "runtime.background-process": {
            "support": "bridge",
            "mechanism": "A plugin-bundled supervisor or stdio MCP server owns the watcher lifecycle."
          },
          "runtime.review-cancel": {
            "support": "bridge",
            "mechanism": "Abort the Hoonsoo-owned review request and advance its generation."
          },
          "session.emit": {
            "support": "unknown",
            "fallback": "Buffer advice until the next host turn."
          },
          "host.generation-interrupt": {
            "support": "unsupported",
            "fallback": "Abort only the Hoonsoo runtime request and discard its stale result."
          },
          "agents.concurrent": {
            "support": "bridge",
            "mechanism": "Codex subagents or the Hoonsoo runtime worker pool."
          }
        }
      }
    }
  }
}
