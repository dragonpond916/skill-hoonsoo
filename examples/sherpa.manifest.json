{
  "$schema": "../schemas/sherpa.manifest.schema.json",
  "schemaVersion": "0.6.0",
  "kind": "SherpaSkill",
  "metadata": {
    "name": "sherpa",
    "displayName": "Sherpa",
    "version": "0.6.0",
    "description": "Review document content and grammar from review contexts embedded in monitor start and saved-revision results without modifying the source file.",
    "homepage": "https://github.com/dragonpond916/skill-sherpa",
    "repository": "https://github.com/dragonpond916/skill-sherpa",
    "keywords": [
      "advice-only",
      "save-triggered-review",
      "single-host-review",
      "fast-path"
    ]
  },
  "skill": {
    "standard": "agentskills.io",
    "path": "./skills/sherpa/SKILL.md",
    "implicitInvocation": true
  },
  "command": {
    "codexInvocation": "$sherpa <filePath> <prompt>",
    "claudeInvocation": "/skill-sherpa:sherpa <filePath> <prompt>",
    "action": "start-or-reconfigure-monitor",
    "reviewScope": "content-and-grammar",
    "arguments": [
      {
        "name": "filePath",
        "position": 0,
        "type": "path",
        "required": true,
        "capture": "token",
        "description": "Absolute local file path. Quote a path that contains spaces."
      },
      {
        "name": "prompt",
        "position": 1,
        "type": "string",
        "required": false,
        "capture": "remainder",
        "default": "",
        "description": "Optional priorities or constraints applied to the combined content and grammar review."
      }
    ]
  },
  "runtime": {
    "kind": "stdio-mcp-process",
    "protocol": "jsonl-stdio",
    "state": {
      "scope": "monitor-session",
      "storage": "memory",
      "retention": "until-monitor-stop-or-process-exit",
      "persistDocumentContent": false,
      "versionedCollections": [
        "revisionSnapshots",
        "diffArtifacts",
        "feedbackArtifacts",
        "reviewLeases"
      ]
    }
  },
  "lifecycle": {
    "scope": "active-agent-turn",
    "startOnInvocation": true,
    "stopConditions": [
      "user-cancelled",
      "session-ended",
      "target-deleted",
      "runtime-failed",
      "idle-timeout"
    ],
    "onTargetDeleted": "confirm-twice-then-notify-and-stop",
    "onTargetReplaced": "capture-new-inode-as-saved-revision",
    "monitorUniqueness": "one-active-monitor-per-process-and-target"
  },
  "watch": {
    "mode": "metadata-polling",
    "pollIntervalMs": 25,
    "throttling": {
      "enabled": false
    },
    "saveDetection": {
      "boundary": "stable-disk-snapshot",
      "candidateMetadata": [
        "device",
        "inode",
        "size",
        "mtimeNs",
        "ctimeNs"
      ],
      "contentIdentity": "raw-utf8-sha256",
      "sameContentSave": "activity-only-no-revision",
      "whitespaceOnlySave": "content-revision",
      "manualVsAutosave": "not-distinguishable",
      "consistencyRead": "stat-read-stat-with-bounded-retry",
      "missingConfirmationProbes": 2
    },
    "idleWarningMs": 60000,
    "idleStopMs": 90000,
    "maxFileBytes": 5242880
  },
  "agents": {
    "monitoringAgent": {
      "role": "save-monitor",
      "implementation": "deterministic-worker",
      "modelClass": "none",
      "responsibility": "Detect metadata changes, capture a stable disk snapshot, and distinguish save activity from content revisions.",
      "inputs": [
        "target-path",
        "save-detection-policy"
      ],
      "outputs": [
        "save-sequence",
        "stable-snapshot-reference"
      ],
      "effectPolicy": "read-target-and-update-session-memory-only"
    },
    "diffCheckAgent": {
      "role": "revision-diff-checker",
      "implementation": "deterministic-worker",
      "modelClass": "none",
      "responsibility": "Version each changed stable snapshot and store bounded aggregate changed excerpts and line ranges.",
      "inputs": [
        "last-published-revision-snapshot",
        "current-stable-snapshot"
      ],
      "outputs": [
        "revision-artifact",
        "diff-artifact"
      ],
      "effectPolicy": "compute-and-update-session-memory-only"
    },
    "combinedReviewAgent": {
      "role": "combined-reviewer",
      "implementation": "current-host",
      "modelClass": "current-host",
      "responsibility": "Consume the review context embedded by monitor start or saved-revision results and produce combined content and grammar advice in a single current-host model pass without spawning a subagent.",
      "inputs": [
        "review-context",
        "invocation-prompt",
        "conversation-history"
      ],
      "outputs": [
        "natural-language-feedback"
      ],
      "effectPolicy": "advice-only-no-file-mutation"
    },
    "revisionGate": {
      "role": "revision-gate",
      "implementation": "deterministic-worker",
      "modelClass": "none",
      "responsibility": "Reject feedback whose review lease, revision, content hash, or source artifact no longer matches current monitor state.",
      "inputs": [
        "review-lease",
        "revision-content-hash-identifiers",
        "runtime-status"
      ],
      "outputs": [
        "publication-marker",
        "stale-decision"
      ],
      "effectPolicy": "validate-and-update-session-memory-only"
    },
    "idleGuard": {
      "role": "idle-guard",
      "implementation": "deterministic-worker",
      "modelClass": "none",
      "responsibility": "Pause idle time while a review lease is active, then restart it after feedback publication or lease expiry.",
      "inputs": [
        "review-lease-state",
        "last-content-revision"
      ],
      "outputs": [
        "idle-warning",
        "idle-stop"
      ],
      "effectPolicy": "timer-and-session-state-only"
    },
    "sessionOrchestrator": {
      "role": "host-session-orchestrator",
      "implementation": "host-agent",
      "modelClass": "current-host",
      "responsibility": "Manage monitor lifecycle, consume embedded review contexts on the normal path, recover context only when necessary, publish accepted natural-language feedback, and perform bounded waits with silent retries.",
      "inputs": [
        "runtime-status",
        "embedded-review-context",
        "recovery-review-context",
        "publication-marker"
      ],
      "outputs": [
        "numbered-advice-batch"
      ],
      "effectPolicy": "presentation-and-session-control-only"
    }
  },
  "pipeline": {
    "sequence": [
      "monitoringAgent",
      "diffCheckAgent",
      "combinedReviewAgent",
      "revisionGate",
      "sessionOrchestrator"
    ],
    "baseline": {
      "internalRevision": 0,
      "reviewInput": "full-revision-context",
      "contextDelivery": "embedded-in-start_monitor"
    },
    "savedRevision": {
      "reviewInput": "aggregate-diff-context",
      "contextDelivery": "embedded-in-wait_for_save"
    },
    "recoveryReviewContext": {
      "tool": "read_review_context",
      "usage": "recovery-only"
    },
    "reviewPassesPerRevision": 1,
    "reviewExecution": "current-host-inline",
    "subagentPolicy": "forbidden",
    "backlogPolicy": "latest-revision-wins-with-aggregate-diff-from-last-published",
    "staleResultPolicy": "reject-by-review-lease-revision-content-hash-and-source",
    "reviewLease": {
      "defaultMs": 180000,
      "idleClockWhileActive": "paused",
      "idleClockResumeOn": [
        "feedback-published",
        "lease-expired"
      ]
    },
    "normalWait": {
      "timeoutMs": 45000,
      "hostToolDefaultMs": 60000,
      "onTimeout": "silent-retry"
    }
  },
  "mcpTools": {
    "public": [
      "start_monitor",
      "read_review_context",
      "publish_feedback",
      "wait_for_save",
      "get_status",
      "stop_monitor"
    ]
  },
  "review": {
    "scope": "content-and-grammar",
    "promptPolicy": "merge-as-additional-priorities",
    "contentChecks": [
      "completeness",
      "consistency",
      "clarity",
      "risk",
      "missing-assumptions",
      "actionability"
    ],
    "grammarChecks": [
      "file-syntax",
      "natural-language-grammar",
      "spelling",
      "punctuation",
      "style",
      "terminology-consistency",
      "whitespace-and-formatting"
    ]
  },
  "output": {
    "mode": "advice-only",
    "presentation": "numbered-natural-language",
    "batchHeading": "세르파의 {n}번째 조언 :",
    "visibleLabels": [],
    "forbiddenLabels": [
      "revision",
      "anchor",
      "category",
      "severity",
      "message",
      "rationale",
      "suggestedAction",
      "confidence"
    ],
    "targetMutation": "forbidden"
  },
  "permissions": {
    "filesystem": {
      "readTarget": true,
      "observeTarget": true,
      "writeTarget": false,
      "writeWorkspace": false
    },
    "runtimeMemory": {
      "writeVersionedArtifacts": true,
      "writeReviewLeases": true,
      "persistAfterStop": false
    },
    "network": {
      "mode": "none"
    },
    "dataHandling": {
      "reviewHost": "current-host",
      "crossProcessArtifactPassing": "not-applicable-single-host",
      "snapshotsRemainLocal": true,
      "retention": "monitor-session"
    }
  }
}
