{
  "name": "skill-sherpa",
  "version": "0.6.0",
  "private": true,
  "description": "Sherpa: fast read-only saved-revision document guidance for Codex and Claude Code",
  "homepage": "https://github.com/dragonpond916/skill-sherpa",
  "repository": "https://github.com/dragonpond916/skill-sherpa",
  "type": "module",
  "engines": {
    "node": ">=18.12"
  },
  "scripts": {
    "package:plugin": "node tools/package-plugin.mjs",
    "check:package": "node tools/package-plugin.mjs --check",
    "test:runtime": "node --test tests/runtime/*.test.mjs",
    "test:package": "node --test tests/package/*.test.mjs",
    "test": "npm run check:package && npm run test:runtime && npm run test:package"
  }
}
