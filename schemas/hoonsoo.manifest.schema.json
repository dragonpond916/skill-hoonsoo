{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dragonpond916/skill-hoonsoo/schemas/hoonsoo.manifest/0.3.0",
  "title": "Hoonsoo save-triggered review manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "metadata",
    "skill",
    "command",
    "runtime",
    "lifecycle",
    "watch",
    "agents",
    "pipeline",
    "mcpTools",
    "review",
    "output",
    "permissions",
    "extensions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "0.3.0"
    },
    "kind": {
      "const": "HoonsooSkill"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "displayName",
        "version",
        "description",
        "keywords"
      ],
      "properties": {
        "name": {
          "const": "hoonsoo"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^0\\.3\\.0-alpha\\.[0-9]+$"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "keywords": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standard",
        "path",
        "implicitInvocation"
      ],
      "properties": {
        "standard": {
          "const": "agentskills.io"
        },
        "path": {
          "const": "./skills/hoonsoo/SKILL.md"
        },
        "implicitInvocation": {
          "type": "boolean"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codexInvocation",
        "claudeInvocation",
        "action",
        "reviewScope",
        "arguments"
      ],
      "properties": {
        "codexInvocation": {
          "const": "$hoonsoo <filePath> <prompt>"
        },
        "claudeInvocation": {
          "const": "/skill-hoonsoo:hoonsoo <filePath> <prompt>"
        },
        "action": {
          "const": "start-or-reconfigure-monitor"
        },
        "reviewScope": {
          "const": "content-and-grammar"
        },
        "arguments": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/filePathArgument"
            },
            {
              "$ref": "#/$defs/promptArgument"
            }
          ],
          "items": false
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "protocol",
        "state"
      ],
      "properties": {
        "kind": {
          "const": "stdio-mcp-process"
        },
        "protocol": {
          "const": "jsonl-stdio"
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "storage",
            "retention",
            "persistDocumentContent",
            "versionedCollections"
          ],
          "properties": {
            "scope": {
              "const": "monitor-session"
            },
            "storage": {
              "const": "memory"
            },
            "retention": {
              "const": "until-monitor-stop-or-process-exit"
            },
            "persistDocumentContent": {
              "const": false
            },
            "versionedCollections": {
              "type": "array",
              "uniqueItems": true,
              "allOf": [
                {
                  "contains": {
                    "const": "revisionSnapshots"
                  }
                },
                {
                  "contains": {
                    "const": "diffArtifacts"
                  }
                },
                {
                  "contains": {
                    "const": "fieldArtifacts"
                  }
                },
                {
                  "contains": {
                    "const": "feedbackArtifacts"
                  }
                }
              ],
              "items": {
                "enum": [
                  "revisionSnapshots",
                  "diffArtifacts",
                  "fieldArtifacts",
                  "feedbackArtifacts"
                ]
              }
            }
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "startOnInvocation",
        "stopConditions",
        "onTargetDeleted",
        "onTargetReplaced",
        "monitorUniqueness"
      ],
      "properties": {
        "scope": {
          "const": "active-agent-turn"
        },
        "startOnInvocation": {
          "const": true
        },
        "stopConditions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "onTargetDeleted": {
          "const": "confirm-twice-then-notify-and-stop"
        },
        "onTargetReplaced": {
          "const": "capture-new-inode-as-saved-revision"
        },
        "monitorUniqueness": {
          "const": "one-active-monitor-per-process-and-target"
        }
      }
    },
    "watch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "pollIntervalMs",
        "throttling",
        "saveDetection",
        "idleWarningMs",
        "idleStopMs",
        "maxFileBytes"
      ],
      "properties": {
        "mode": {
          "const": "metadata-polling"
        },
        "pollIntervalMs": {
          "type": "integer",
          "minimum": 25,
          "maximum": 60000
        },
        "throttling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "const": false
            }
          }
        },
        "saveDetection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "boundary",
            "candidateMetadata",
            "contentIdentity",
            "sameContentSave",
            "whitespaceOnlySave",
            "manualVsAutosave",
            "consistencyRead",
            "missingConfirmationProbes"
          ],
          "properties": {
            "boundary": {
              "const": "stable-disk-snapshot"
            },
            "candidateMetadata": {
              "type": "array",
              "uniqueItems": true,
              "allOf": [
                {
                  "contains": {
                    "const": "size"
                  }
                },
                {
                  "contains": {
                    "const": "mtimeNs"
                  }
                },
                {
                  "contains": {
                    "const": "inode"
                  }
                }
              ],
              "items": {
                "enum": [
                  "device",
                  "inode",
                  "size",
                  "mtimeNs",
                  "ctimeNs"
                ]
              }
            },
            "contentIdentity": {
              "const": "raw-utf8-sha256"
            },
            "sameContentSave": {
              "const": "activity-only-no-revision"
            },
            "whitespaceOnlySave": {
              "const": "content-revision"
            },
            "manualVsAutosave": {
              "const": "not-distinguishable"
            },
            "consistencyRead": {
              "const": "stat-read-stat-with-bounded-retry"
            },
            "missingConfirmationProbes": {
              "type": "integer",
              "minimum": 2
            }
          }
        },
        "idleWarningMs": {
          "type": "integer",
          "minimum": 1
        },
        "idleStopMs": {
          "type": "integer",
          "minimum": 2
        },
        "maxFileBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "monitoringAgent",
        "diffCheckAgent",
        "fieldCheckAgent",
        "mainReviewAgent",
        "revisionGate",
        "idleGuard",
        "sessionOrchestrator"
      ],
      "properties": {
        "monitoringAgent": {
          "$ref": "#/$defs/agent"
        },
        "diffCheckAgent": {
          "$ref": "#/$defs/agent"
        },
        "fieldCheckAgent": {
          "$ref": "#/$defs/agent"
        },
        "mainReviewAgent": {
          "$ref": "#/$defs/agent"
        },
        "revisionGate": {
          "$ref": "#/$defs/agent"
        },
        "idleGuard": {
          "$ref": "#/$defs/agent"
        },
        "sessionOrchestrator": {
          "$ref": "#/$defs/agent"
        }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "baseline",
        "savedRevision",
        "backlogPolicy",
        "staleResultPolicy",
        "interAgentPayload",
        "normalWait"
      ],
      "properties": {
        "sequence": {
          "type": "array",
          "minItems": 6,
          "items": {
            "enum": [
              "monitoringAgent",
              "diffCheckAgent",
              "fieldCheckAgent",
              "mainReviewAgent",
              "revisionGate",
              "sessionOrchestrator"
            ]
          }
        },
        "baseline": {
          "$ref": "#/$defs/reviewStage"
        },
        "savedRevision": {
          "$ref": "#/$defs/savedReviewStage"
        },
        "backlogPolicy": {
          "const": "latest-revision-wins-with-aggregate-diff-from-last-published"
        },
        "staleResultPolicy": {
          "const": "reject-by-revision-content-hash-and-artifact-id"
        },
        "interAgentPayload": {
          "const": "artifact-references-only"
        },
        "normalWait": {
          "const": "event-driven-without-timeout"
        }
      }
    },
    "mcpTools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "monitoring",
        "artifactReads",
        "sessionWrites"
      ],
      "properties": {
        "monitoring": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "artifactReads": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "sessionWrites": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "promptPolicy",
        "contentChecks",
        "grammarChecks"
      ],
      "properties": {
        "scope": {
          "const": "content-and-grammar"
        },
        "promptPolicy": {
          "const": "merge-as-additional-priorities"
        },
        "contentChecks": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "grammarChecks": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "presentation",
        "visibleLabels",
        "forbiddenLabels",
        "targetMutation"
      ],
      "properties": {
        "mode": {
          "const": "advice-only"
        },
        "presentation": {
          "const": "numbered-natural-language"
        },
        "visibleLabels": {
          "type": "array",
          "contains": {
            "const": "revision"
          },
          "items": {
            "type": "string"
          }
        },
        "forbiddenLabels": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "targetMutation": {
          "const": "forbidden"
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesystem",
        "runtimeMemory",
        "network",
        "dataHandling"
      ],
      "properties": {
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "readTarget",
            "observeTarget",
            "writeTarget",
            "writeWorkspace"
          ],
          "properties": {
            "readTarget": {
              "const": true
            },
            "observeTarget": {
              "const": true
            },
            "writeTarget": {
              "const": false
            },
            "writeWorkspace": {
              "const": false
            }
          }
        },
        "runtimeMemory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "writeVersionedArtifacts",
            "persistAfterStop"
          ],
          "properties": {
            "writeVersionedArtifacts": {
              "const": true
            },
            "persistAfterStop": {
              "const": false
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "none"
            }
          }
        },
        "dataHandling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "documentInterAgentPassing",
            "artifactReads",
            "snapshotsRemainLocal",
            "retention"
          ],
          "properties": {
            "documentInterAgentPassing": {
              "const": "references-only"
            },
            "artifactReads": {
              "const": "direct-mcp-access"
            },
            "snapshotsRemainLocal": {
              "const": true
            },
            "retention": {
              "const": "monitor-session"
            }
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hoonsoo.model-routing",
        "hoonsoo.optional-source-scout"
      ],
      "properties": {
        "hoonsoo.model-routing": {
          "$ref": "#/$defs/modelRouting"
        },
        "hoonsoo.optional-source-scout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "automaticInstallation"
          ],
          "properties": {
            "enabled": {
              "const": "on-demand-only"
            },
            "automaticInstallation": {
              "const": false
            }
          }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "filePathArgument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "position",
        "type",
        "required",
        "capture",
        "description"
      ],
      "properties": {
        "name": {
          "const": "filePath"
        },
        "position": {
          "const": 0
        },
        "type": {
          "const": "path"
        },
        "required": {
          "const": true
        },
        "capture": {
          "const": "token"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "promptArgument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "position",
        "type",
        "required",
        "capture",
        "default",
        "description"
      ],
      "properties": {
        "name": {
          "const": "prompt"
        },
        "position": {
          "const": 1
        },
        "type": {
          "const": "string"
        },
        "required": {
          "const": false
        },
        "capture": {
          "const": "remainder"
        },
        "default": {
          "const": ""
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "implementation",
        "modelClass",
        "responsibility",
        "inputs",
        "outputs",
        "effectPolicy"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "implementation": {
          "enum": [
            "deterministic-worker",
            "llm-agent",
            "host-agent"
          ]
        },
        "modelClass": {
          "enum": [
            "none",
            "efficient",
            "flagship",
            "current-host"
          ]
        },
        "responsibility": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "inputs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "outputs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "effectPolicy": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "reviewStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "fieldInput",
        "review"
      ],
      "properties": {
        "revision": {
          "const": 0
        },
        "fieldInput": {
          "const": "full-revision-artifact"
        },
        "review": {
          "const": "combined-content-and-grammar"
        }
      }
    },
    "savedReviewStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fieldInput",
        "reviewInput",
        "review"
      ],
      "properties": {
        "fieldInput": {
          "const": "diff-artifact"
        },
        "reviewInput": {
          "const": "review-bundle"
        },
        "review": {
          "const": "combined-content-and-grammar"
        }
      }
    },
    "modelRouting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "deterministicRoles",
        "hostProfiles"
      ],
      "properties": {
        "mode": {
          "const": "host-capability-gated"
        },
        "deterministicRoles": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "hostProfiles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "codex",
            "claude-code"
          ],
          "properties": {
            "codex": {
              "$ref": "#/$defs/hostProfile"
            },
            "claude-code": {
              "$ref": "#/$defs/hostProfile"
            }
          }
        }
      }
    },
    "hostProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fieldChecker",
        "fieldCheckerReasoning",
        "mainReviewer",
        "mainReviewerReasoning",
        "fallback"
      ],
      "properties": {
        "fieldChecker": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "fieldCheckerReasoning": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "mainReviewer": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "mainReviewerReasoning": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "fallback": {
          "const": "current-host-model"
        }
      }
    }
  }
}
