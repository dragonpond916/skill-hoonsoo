{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dragonpond916/skill-sherpa/schemas/sherpa.manifest/0.6.0",
  "title": "Sherpa fast saved-review manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "metadata",
    "skill",
    "command",
    "runtime",
    "lifecycle",
    "watch",
    "agents",
    "pipeline",
    "mcpTools",
    "review",
    "output",
    "permissions"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/sherpa.manifest.schema.json"
    },
    "schemaVersion": {
      "const": "0.6.0"
    },
    "kind": {
      "const": "SherpaSkill"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "displayName",
        "version",
        "description",
        "homepage",
        "repository",
        "keywords"
      ],
      "properties": {
        "name": {
          "const": "sherpa"
        },
        "displayName": {
          "const": "Sherpa"
        },
        "version": {
          "const": "0.6.0"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "homepage": {
          "const": "https://github.com/dragonpond916/skill-sherpa"
        },
        "repository": {
          "const": "https://github.com/dragonpond916/skill-sherpa"
        },
        "keywords": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standard",
        "path",
        "implicitInvocation"
      ],
      "properties": {
        "standard": {
          "const": "agentskills.io"
        },
        "path": {
          "const": "./skills/sherpa/SKILL.md"
        },
        "implicitInvocation": {
          "type": "boolean"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codexInvocation",
        "claudeInvocation",
        "action",
        "reviewScope",
        "arguments"
      ],
      "properties": {
        "codexInvocation": {
          "const": "$sherpa <filePath> <prompt>"
        },
        "claudeInvocation": {
          "const": "/skill-sherpa:sherpa <filePath> <prompt>"
        },
        "action": {
          "const": "start-or-reconfigure-monitor"
        },
        "reviewScope": {
          "const": "content-and-grammar"
        },
        "arguments": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/filePathArgument"
            },
            {
              "$ref": "#/$defs/promptArgument"
            }
          ],
          "items": false
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "protocol",
        "state"
      ],
      "properties": {
        "kind": {
          "const": "stdio-mcp-process"
        },
        "protocol": {
          "const": "jsonl-stdio"
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "storage",
            "retention",
            "persistDocumentContent",
            "versionedCollections"
          ],
          "properties": {
            "scope": {
              "const": "monitor-session"
            },
            "storage": {
              "const": "memory"
            },
            "retention": {
              "const": "until-monitor-stop-or-process-exit"
            },
            "persistDocumentContent": {
              "const": false
            },
            "versionedCollections": {
              "const": [
                "revisionSnapshots",
                "diffArtifacts",
                "feedbackArtifacts",
                "reviewLeases"
              ]
            }
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "startOnInvocation",
        "stopConditions",
        "onTargetDeleted",
        "onTargetReplaced",
        "monitorUniqueness"
      ],
      "properties": {
        "scope": {
          "const": "active-agent-turn"
        },
        "startOnInvocation": {
          "const": true
        },
        "stopConditions": {
          "const": [
            "user-cancelled",
            "session-ended",
            "target-deleted",
            "runtime-failed",
            "idle-timeout"
          ]
        },
        "onTargetDeleted": {
          "const": "confirm-twice-then-notify-and-stop"
        },
        "onTargetReplaced": {
          "const": "capture-new-inode-as-saved-revision"
        },
        "monitorUniqueness": {
          "const": "one-active-monitor-per-process-and-target"
        }
      }
    },
    "watch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "pollIntervalMs",
        "throttling",
        "saveDetection",
        "idleWarningMs",
        "idleStopMs",
        "maxFileBytes"
      ],
      "properties": {
        "mode": {
          "const": "metadata-polling"
        },
        "pollIntervalMs": {
          "const": 25
        },
        "throttling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "const": false
            }
          }
        },
        "saveDetection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "boundary",
            "candidateMetadata",
            "contentIdentity",
            "sameContentSave",
            "whitespaceOnlySave",
            "manualVsAutosave",
            "consistencyRead",
            "missingConfirmationProbes"
          ],
          "properties": {
            "boundary": {
              "const": "stable-disk-snapshot"
            },
            "candidateMetadata": {
              "const": [
                "device",
                "inode",
                "size",
                "mtimeNs",
                "ctimeNs"
              ]
            },
            "contentIdentity": {
              "const": "raw-utf8-sha256"
            },
            "sameContentSave": {
              "const": "activity-only-no-revision"
            },
            "whitespaceOnlySave": {
              "const": "content-revision"
            },
            "manualVsAutosave": {
              "const": "not-distinguishable"
            },
            "consistencyRead": {
              "const": "stat-read-stat-with-bounded-retry"
            },
            "missingConfirmationProbes": {
              "const": 2
            }
          }
        },
        "idleWarningMs": {
          "const": 60000
        },
        "idleStopMs": {
          "const": 90000
        },
        "maxFileBytes": {
          "const": 5242880
        }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "monitoringAgent",
        "diffCheckAgent",
        "combinedReviewAgent",
        "revisionGate",
        "idleGuard",
        "sessionOrchestrator"
      ],
      "properties": {
        "monitoringAgent": {
          "allOf": [
            {
              "$ref": "#/$defs/deterministicAgent"
            },
            {
              "properties": {
                "role": {
                  "const": "save-monitor"
                }
              }
            }
          ]
        },
        "diffCheckAgent": {
          "allOf": [
            {
              "$ref": "#/$defs/deterministicAgent"
            },
            {
              "properties": {
                "role": {
                  "const": "revision-diff-checker"
                }
              }
            }
          ]
        },
        "combinedReviewAgent": {
          "$ref": "#/$defs/combinedReviewAgent"
        },
        "revisionGate": {
          "allOf": [
            {
              "$ref": "#/$defs/deterministicAgent"
            },
            {
              "properties": {
                "role": {
                  "const": "revision-gate"
                }
              }
            }
          ]
        },
        "idleGuard": {
          "allOf": [
            {
              "$ref": "#/$defs/deterministicAgent"
            },
            {
              "properties": {
                "role": {
                  "const": "idle-guard"
                }
              }
            }
          ]
        },
        "sessionOrchestrator": {
          "$ref": "#/$defs/sessionOrchestrator"
        }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "baseline",
        "savedRevision",
        "recoveryReviewContext",
        "reviewPassesPerRevision",
        "reviewExecution",
        "subagentPolicy",
        "backlogPolicy",
        "staleResultPolicy",
        "reviewLease",
        "normalWait"
      ],
      "properties": {
        "sequence": {
          "const": [
            "monitoringAgent",
            "diffCheckAgent",
            "combinedReviewAgent",
            "revisionGate",
            "sessionOrchestrator"
          ]
        },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "internalRevision",
            "reviewInput",
            "contextDelivery"
          ],
          "properties": {
            "internalRevision": {
              "const": 0
            },
            "reviewInput": {
              "const": "full-revision-context"
            },
            "contextDelivery": {
              "const": "embedded-in-start_monitor"
            }
          }
        },
        "savedRevision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewInput",
            "contextDelivery"
          ],
          "properties": {
            "reviewInput": {
              "const": "aggregate-diff-context"
            },
            "contextDelivery": {
              "const": "embedded-in-wait_for_save"
            }
          }
        },
        "recoveryReviewContext": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool",
            "usage"
          ],
          "properties": {
            "tool": {
              "const": "read_review_context"
            },
            "usage": {
              "const": "recovery-only"
            }
          }
        },
        "reviewPassesPerRevision": {
          "const": 1
        },
        "reviewExecution": {
          "const": "current-host-inline"
        },
        "subagentPolicy": {
          "const": "forbidden"
        },
        "backlogPolicy": {
          "const": "latest-revision-wins-with-aggregate-diff-from-last-published"
        },
        "staleResultPolicy": {
          "const": "reject-by-review-lease-revision-content-hash-and-source"
        },
        "reviewLease": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "defaultMs",
            "idleClockWhileActive",
            "idleClockResumeOn"
          ],
          "properties": {
            "defaultMs": {
              "const": 180000
            },
            "idleClockWhileActive": {
              "const": "paused"
            },
            "idleClockResumeOn": {
              "const": [
                "feedback-published",
                "lease-expired"
              ]
            }
          }
        },
        "normalWait": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "timeoutMs",
            "hostToolDefaultMs",
            "onTimeout"
          ],
          "properties": {
            "timeoutMs": {
              "const": 45000
            },
            "hostToolDefaultMs": {
              "const": 60000
            },
            "onTimeout": {
              "const": "silent-retry"
            }
          }
        }
      }
    },
    "mcpTools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public"
      ],
      "properties": {
        "public": {
          "const": [
            "start_monitor",
            "read_review_context",
            "publish_feedback",
            "wait_for_save",
            "get_status",
            "stop_monitor"
          ]
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "promptPolicy",
        "contentChecks",
        "grammarChecks"
      ],
      "properties": {
        "scope": {
          "const": "content-and-grammar"
        },
        "promptPolicy": {
          "const": "merge-as-additional-priorities"
        },
        "contentChecks": {
          "const": [
            "completeness",
            "consistency",
            "clarity",
            "risk",
            "missing-assumptions",
            "actionability"
          ]
        },
        "grammarChecks": {
          "const": [
            "file-syntax",
            "natural-language-grammar",
            "spelling",
            "punctuation",
            "style",
            "terminology-consistency",
            "whitespace-and-formatting"
          ]
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "presentation",
        "batchHeading",
        "visibleLabels",
        "forbiddenLabels",
        "targetMutation"
      ],
      "properties": {
        "mode": {
          "const": "advice-only"
        },
        "presentation": {
          "const": "numbered-natural-language"
        },
        "batchHeading": {
          "const": "세르파의 {n}번째 조언 :"
        },
        "visibleLabels": {
          "const": []
        },
        "forbiddenLabels": {
          "const": [
            "revision",
            "anchor",
            "category",
            "severity",
            "message",
            "rationale",
            "suggestedAction",
            "confidence"
          ]
        },
        "targetMutation": {
          "const": "forbidden"
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesystem",
        "runtimeMemory",
        "network",
        "dataHandling"
      ],
      "properties": {
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "readTarget",
            "observeTarget",
            "writeTarget",
            "writeWorkspace"
          ],
          "properties": {
            "readTarget": {
              "const": true
            },
            "observeTarget": {
              "const": true
            },
            "writeTarget": {
              "const": false
            },
            "writeWorkspace": {
              "const": false
            }
          }
        },
        "runtimeMemory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "writeVersionedArtifacts",
            "writeReviewLeases",
            "persistAfterStop"
          ],
          "properties": {
            "writeVersionedArtifacts": {
              "const": true
            },
            "writeReviewLeases": {
              "const": true
            },
            "persistAfterStop": {
              "const": false
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "none"
            }
          }
        },
        "dataHandling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewHost",
            "crossProcessArtifactPassing",
            "snapshotsRemainLocal",
            "retention"
          ],
          "properties": {
            "reviewHost": {
              "const": "current-host"
            },
            "crossProcessArtifactPassing": {
              "const": "not-applicable-single-host"
            },
            "snapshotsRemainLocal": {
              "const": true
            },
            "retention": {
              "const": "monitor-session"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "filePathArgument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "position",
        "type",
        "required",
        "capture",
        "description"
      ],
      "properties": {
        "name": {
          "const": "filePath"
        },
        "position": {
          "const": 0
        },
        "type": {
          "const": "path"
        },
        "required": {
          "const": true
        },
        "capture": {
          "const": "token"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "promptArgument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "position",
        "type",
        "required",
        "capture",
        "default",
        "description"
      ],
      "properties": {
        "name": {
          "const": "prompt"
        },
        "position": {
          "const": 1
        },
        "type": {
          "const": "string"
        },
        "required": {
          "const": false
        },
        "capture": {
          "const": "remainder"
        },
        "default": {
          "const": ""
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "deterministicAgent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "implementation",
        "modelClass",
        "responsibility",
        "inputs",
        "outputs",
        "effectPolicy"
      ],
      "properties": {
        "role": {
          "enum": [
            "save-monitor",
            "revision-diff-checker",
            "revision-gate",
            "idle-guard"
          ]
        },
        "implementation": {
          "const": "deterministic-worker"
        },
        "modelClass": {
          "const": "none"
        },
        "responsibility": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "inputs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "outputs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "effectPolicy": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "combinedReviewAgent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "implementation",
        "modelClass",
        "responsibility",
        "inputs",
        "outputs",
        "effectPolicy"
      ],
      "properties": {
        "role": {
          "const": "combined-reviewer"
        },
        "implementation": {
          "const": "current-host"
        },
        "modelClass": {
          "const": "current-host"
        },
        "responsibility": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "inputs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "outputs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "effectPolicy": {
          "const": "advice-only-no-file-mutation"
        }
      }
    },
    "sessionOrchestrator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "implementation",
        "modelClass",
        "responsibility",
        "inputs",
        "outputs",
        "effectPolicy"
      ],
      "properties": {
        "role": {
          "const": "host-session-orchestrator"
        },
        "implementation": {
          "const": "host-agent"
        },
        "modelClass": {
          "const": "current-host"
        },
        "responsibility": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "inputs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "outputs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "effectPolicy": {
          "const": "presentation-and-session-control-only"
        }
      }
    }
  }
}
